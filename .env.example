# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/union

# 채널톡 플러그인 키 (채널톡 관리자 > 설정 > 개발자 > 플러그인 키)
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=your-channel-talk-plugin-key

